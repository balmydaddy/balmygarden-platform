{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "mcp__Notion",
      "mcp__d34fa2e2-673d-4ec2-a752-534f3601894a"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_md_tables.py\"",
            "timeout": 20,
            "statusMessage": "마크다운 표 검사"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_secrets.py\"",
            "timeout": 20,
            "statusMessage": "시크릿 노출 검사"
          }
        ]
      }
    ]
  }
}
